---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import data from '../data/home.json';

const { hero, keyStats, mission, pillars, industryStats, getInvolved, investments } = data;

// SVG icon paths for pillars (not CMS-editable, design concern)
const pillarIcons = [
  { bg: 'bg-cranberry-100', hoverBg: 'group-hover:bg-cranberry-200', color: 'text-cranberry-700', path: 'M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611l-.292.058a2.25 2.25 0 01-1.067-.06l-1.196-.3a9 9 0 00-4.56 0l-1.196.3a2.25 2.25 0 01-1.067.06l-.292-.058c-1.717-.293-2.299-2.379-1.067-3.611L5 14.5' },
  { bg: 'bg-forest-100', hoverBg: 'group-hover:bg-forest-200', color: 'text-forest-700', path: 'M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5' },
  { bg: 'bg-earth-100', hoverBg: 'group-hover:bg-earth-200', color: 'text-earth-700', path: 'M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941' },
  { bg: 'bg-forest-100', hoverBg: 'group-hover:bg-forest-200', color: 'text-forest-700', path: 'M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 003 12c0-1.605.42-3.113 1.157-4.418' },
];
---

<Layout title="Home" description="The Wisconsin Cranberry Board invests in research, promotion, and education to support Wisconsin's cranberry industry — America's #1 cranberry-producing state.">

  <!-- Hero Section -->
  <section class="relative bg-cranberry-950 overflow-hidden" aria-labelledby="hero-heading">
    <div class="absolute inset-0">
      <img
        src={hero.image}
        alt={hero.imageAlt}
        class="w-full h-full object-cover opacity-40"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-cranberry-950/90 via-cranberry-950/70 to-cranberry-950/50"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-28 lg:py-40">
      <div class="max-w-3xl">
        <p class="text-cranberry-300 text-sm font-semibold uppercase tracking-widest mb-4">{hero.badge}</p>
        <h1 id="hero-heading" class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight font-heading mb-6">
          {hero.title}
        </h1>
        <p class="text-lg sm:text-xl text-cranberry-100 leading-relaxed mb-10 max-w-2xl">
          {hero.description}
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/about" class="inline-flex items-center justify-center px-8 py-4 bg-white text-cranberry-900 rounded-lg font-semibold hover:bg-cranberry-50 transition-colors shadow-lg text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
            About the Board
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </a>
          <a href="/grower-resources" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white/30 text-white rounded-lg font-semibold hover:bg-white/10 transition-colors text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
            Grower Resources
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Stats Bar -->
  <section class="bg-cranberry-800 border-t border-cranberry-700" aria-label="Key statistics">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        {keyStats.map((stat) => (
          <div>
            <div class="text-3xl sm:text-4xl font-bold text-white font-heading">{stat.value}</div>
            <div class="text-cranberry-200 text-sm mt-1">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mission Overview -->
  <section class="py-20 lg:py-28 bg-warm-50" aria-labelledby="mission-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-cranberry-700 text-sm font-semibold uppercase tracking-widest mb-3">{mission.badge}</p>
          <h2 id="mission-heading" class="text-3xl sm:text-4xl font-bold text-cranberry-950 font-heading mb-6 leading-tight">
            {mission.title}
          </h2>
          <p class="text-earth-700 text-lg leading-relaxed mb-6">
            {mission.paragraph1}
          </p>
          <p class="text-earth-600 leading-relaxed mb-8">
            {mission.paragraph2}
          </p>
          <a href="/about" class="inline-flex items-center text-cranberry-700 font-semibold hover:text-cranberry-800 transition-colors group focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cranberry-700 rounded-sm">
            {mission.linkText}
            <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </a>
        </div>
        <div class="relative">
          <img
            src={mission.image}
            alt={mission.imageAlt}
            class="rounded-2xl shadow-2xl w-full object-cover aspect-[4/3]"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute -bottom-6 -left-6 bg-cranberry-700 text-white rounded-xl px-6 py-4 shadow-lg hidden sm:block" aria-hidden="true">
            <div class="text-2xl font-bold font-heading">{mission.sinceYear}</div>
            <div class="text-cranberry-200 text-sm">{mission.sinceLabel}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Four Pillars -->
  <section class="py-20 lg:py-28 bg-white" aria-labelledby="pillars-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading badge="What We Do" title="Our Strategic Pillars" />
      <div id="pillars-heading" class="sr-only">Our Strategic Pillars</div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {pillars.map((pillar, i) => {
          const icon = pillarIcons[i];
          return (
            <article class="bg-warm-50 rounded-2xl p-8 border border-warm-200 hover:border-cranberry-300 hover:shadow-lg transition-all duration-300 group">
              <div class={`w-14 h-14 ${icon.bg} rounded-xl flex items-center justify-center mb-6 ${icon.hoverBg} transition-colors`} aria-hidden="true">
                <svg class={`w-7 h-7 ${icon.color}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={icon.path}></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-cranberry-900 font-heading mb-3">{pillar.title}</h3>
              <p class="text-earth-600 text-sm leading-relaxed">
                {pillar.description}
              </p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Wisconsin Cranberry Stats Section -->
  <section class="py-20 lg:py-28 bg-cranberry-900 relative overflow-hidden" aria-labelledby="stats-heading">
    <div class="absolute inset-0 opacity-10">
      <img
        src={industryStats.backgroundImage}
        alt=""
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
        aria-hidden="true"
      />
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="text-cranberry-300 text-sm font-semibold uppercase tracking-widest mb-3">{industryStats.badge}</p>
        <h2 id="stats-heading" class="text-3xl sm:text-4xl font-bold text-white font-heading">{industryStats.title}</h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8" role="list" aria-label="Industry statistics">
        {industryStats.stats.map((stat) => (
          <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-8 text-center border border-white/10" role="listitem">
            <div class="text-5xl font-bold text-white font-heading mb-2">{stat.value}</div>
            <div class="text-cranberry-200 font-medium">{stat.label}</div>
            <div class="text-cranberry-400 text-sm mt-2">{stat.detail}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quick Links / CTA Section -->
  <section class="py-20 lg:py-28 bg-warm-50" aria-labelledby="help-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="text-cranberry-700 text-sm font-semibold uppercase tracking-widest mb-3">{getInvolved.badge}</p>
        <h2 id="help-heading" class="text-3xl sm:text-4xl font-bold text-cranberry-950 font-heading">{getInvolved.title}</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {getInvolved.cards.map((card) => (
          <a href={card.link} class="group bg-white rounded-2xl overflow-hidden shadow-sm border border-warm-200 hover:shadow-xl hover:border-cranberry-300 transition-all duration-300 block focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cranberry-700">
            <div class="relative h-48 overflow-hidden">
              <img
                src={card.image}
                alt={card.imageAlt}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
            </div>
            <div class="p-8">
              <h3 class="text-xl font-bold text-cranberry-900 font-heading mb-3 group-hover:text-cranberry-700 transition-colors">{card.title}</h3>
              <p class="text-earth-600 text-sm leading-relaxed mb-4">
                {card.description}
              </p>
              <span class="inline-flex items-center text-cranberry-700 font-semibold text-sm group-hover:translate-x-1 transition-transform" aria-hidden="true">
                {card.linkText}
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Board Investment Section -->
  <section class="py-20 lg:py-28 bg-white border-t border-warm-200" aria-labelledby="investment-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="order-2 lg:order-1">
          <img
            src={investments.image}
            alt={investments.imageAlt}
            class="rounded-2xl shadow-2xl w-full object-cover aspect-[4/3]"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="order-1 lg:order-2">
          <p class="text-cranberry-700 text-sm font-semibold uppercase tracking-widest mb-3">{investments.badge}</p>
          <h2 id="investment-heading" class="text-3xl sm:text-4xl font-bold text-cranberry-950 font-heading mb-6 leading-tight">
            {investments.title}
          </h2>
          <p class="text-earth-700 text-lg leading-relaxed mb-6">
            {investments.description}
          </p>
          <ul class="space-y-4 mb-8" role="list">
            {investments.items.map((item) => (
              <li class="flex items-start gap-3">
                <div class="w-6 h-6 bg-cranberry-100 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5" aria-hidden="true">
                  <svg class="w-3.5 h-3.5 text-cranberry-700" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                </div>
                <div>
                  <strong class="text-cranberry-900">{item.label}</strong>
                  <span class="text-earth-600"> {item.detail}</span>
                </div>
              </li>
            ))}
          </ul>
          <a href="/programs-research" class="inline-flex items-center text-cranberry-700 font-semibold hover:text-cranberry-800 transition-colors group focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cranberry-700 rounded-sm">
            {investments.linkText}
            <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
