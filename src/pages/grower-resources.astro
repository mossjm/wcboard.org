---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ResourceCard from '../components/ResourceCard.astro';
import data from '../data/grower-resources.json';

const { hero, assessment, allocation, elections, resources } = data;

const colorMap: Record<string, { bar: string; }> = {
  cranberry: { bar: 'bg-cranberry-600' },
  forest: { bar: 'bg-forest-600' },
  earth: { bar: 'bg-earth-500' },
};
---

<Layout title="Grower Resources" description="Resources, information, and support for Wisconsin cranberry growers from the Wisconsin Cranberry Board.">

  <Hero
    title={hero.title}
    subtitle={hero.subtitle}
    description={hero.description}
    image={hero.image}
    imageAlt={hero.imageAlt}
  />

  <Breadcrumb items={[{ label: 'Grower Resources' }]} />

  <!-- Assessment Information -->
  <section class="py-20 lg:py-28 bg-warm-50" aria-labelledby="assessment-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <div>
          <h2 id="assessment-heading" class="text-3xl font-bold text-cranberry-950 font-heading mb-6">{assessment.title}</h2>
          <p class="text-earth-700 text-lg leading-relaxed mb-6">
            {assessment.description}
          </p>
          <div class="bg-white rounded-2xl p-8 border border-warm-200 shadow-sm mb-8">
            <h3 class="text-xl font-bold text-cranberry-900 font-heading mb-4">{assessment.rateTitle}</h3>
            <div class="flex items-center gap-4 mb-4">
              <div class="text-4xl font-bold text-cranberry-700 font-heading">{assessment.rateValue}</div>
              <div class="text-earth-600">{assessment.rateUnit}</div>
            </div>
            <p class="text-earth-600 text-sm leading-relaxed">
              {assessment.rateDescription}
            </p>
          </div>
          <p class="text-earth-600 leading-relaxed">
            {assessment.producerNote}
          </p>
        </div>

        <div class="space-y-6">
          <!-- Where Your Assessment Goes -->
          <div class="bg-white rounded-2xl p-8 border border-warm-200 shadow-sm">
            <h3 class="text-xl font-bold text-cranberry-900 font-heading mb-6">{allocation.title}</h3>
            <div class="space-y-5">
              {allocation.items.map((item) => {
                const colors = colorMap[item.color] || colorMap.cranberry;
                return (
                  <div>
                    <div class="flex justify-between items-center mb-2">
                      <span class="text-earth-700 font-medium">{item.label}</span>
                      <span class="text-cranberry-700 font-bold">~{item.percentage}%</span>
                    </div>
                    <div class="w-full bg-warm-100 rounded-full h-3" role="progressbar" aria-valuenow={item.percentage} aria-valuemin={0} aria-valuemax={100} aria-label={`${item.label}: approximately ${item.percentage}%`}>
                      <div class={`${colors.bar} h-3 rounded-full`} style={`width: ${item.percentage}%`}></div>
                    </div>
                  </div>
                );
              })}
            </div>
            <p class="text-earth-600 text-xs mt-4">
              {allocation.note}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Board Elections -->
  <section class="py-20 lg:py-28 bg-white border-t border-warm-200" aria-labelledby="elections-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h2 id="elections-heading" class="text-3xl font-bold text-cranberry-950 font-heading mb-6">{elections.title}</h2>
        <p class="text-earth-700 text-lg leading-relaxed mb-8">
          {elections.description}
        </p>

        <div class="grid md:grid-cols-2 gap-8 mb-12">
          <div class="bg-warm-50 rounded-2xl p-8 border border-warm-200">
            <h3 class="text-xl font-bold text-cranberry-900 font-heading mb-4">{elections.howToRunTitle}</h3>
            <ol class="space-y-3 text-earth-700 text-sm" role="list">
              {elections.steps.map((step, i) => (
                <li class="flex items-start gap-3">
                  <span class="bg-cranberry-700 text-white w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold" aria-hidden="true">{i + 1}</span>
                  <span>{step}</span>
                </li>
              ))}
            </ol>
          </div>

          <div class="bg-warm-50 rounded-2xl p-8 border border-warm-200">
            <h3 class="text-xl font-bold text-cranberry-900 font-heading mb-4">{elections.meetingsTitle}</h3>
            <p class="text-earth-700 text-sm leading-relaxed mb-4">
              {elections.meetingsDescription}
            </p>
            <p class="text-earth-700 text-sm leading-relaxed mb-4">
              {elections.meetingsPublicNote}
            </p>
            <div class="bg-cranberry-50 rounded-xl p-4">
              <p class="text-cranberry-800 text-sm font-medium">{elections.electionContactLabel}</p>
              <p class="text-earth-600 text-sm">{elections.electionContactOrg}<br />
                <a href={`tel:${elections.electionContactPhone.replace(/[^0-9]/g, '')}`} class="text-cranberry-700 hover:text-cranberry-800 underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cranberry-700 rounded-sm">{elections.electionContactPhone}</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Resources & Links -->
  <section class="py-20 lg:py-28 bg-warm-50 border-t border-warm-200" aria-labelledby="resources-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 id="resources-heading" class="text-3xl font-bold text-cranberry-950 font-heading mb-4">{resources.title}</h2>
        <p class="text-earth-600 max-w-2xl mx-auto">
          {resources.description}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {resources.items.map((resource) => (
          <ResourceCard
            title={resource.title}
            description={resource.description}
            href={resource.href}
            linkText={resource.linkText}
          />
        ))}
      </div>
    </div>
  </section>

</Layout>
