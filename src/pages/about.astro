---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import BoardMemberCard from '../components/BoardMemberCard.astro';
import { getCollection } from 'astro:content';
import data from '../data/about.json';

const boardMembersData = await getCollection('board-members');
const boardMembers = boardMembersData
  .sort((a, b) => a.data.order - b.data.order)
  .map(m => m.data);

const { hero, mission, purpose, funding, history, boardSection, staff } = data;
---

<Layout title="About" description="Learn about the Wisconsin Cranberry Board's mission, purpose, funding structure, and the grower-elected board members who guide the industry.">

  <Hero
    title={hero.title}
    subtitle={hero.subtitle}
    description={hero.description}
    image={hero.image}
    imageAlt={hero.imageAlt}
  />

  <Breadcrumb items={[{ label: 'About' }]} />

  <!-- Mission & Purpose -->
  <section class="py-20 lg:py-28 bg-warm-50" aria-labelledby="mission-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16">
        <div>
          <h2 id="mission-heading" class="text-3xl font-bold text-cranberry-950 font-heading mb-6">{mission.title}</h2>
          <p class="text-earth-700 text-lg leading-relaxed mb-8">
            {mission.text}
          </p>

          <h3 class="text-3xl font-bold text-cranberry-950 font-heading mb-6">{purpose.title}</h3>
          <p class="text-earth-700 text-lg leading-relaxed mb-6">
            {purpose.text}
          </p>
          <p class="text-earth-600 leading-relaxed mb-4">{purpose.intro}</p>
          <ul class="space-y-3 mb-8" role="list">
            {purpose.items.map((item) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-cranberry-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                <span class="text-earth-700">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <!-- Funding Structure -->
          <div class="bg-white rounded-2xl p-8 shadow-sm border border-warm-200 mb-8">
            <h3 class="text-2xl font-bold text-cranberry-950 font-heading mb-4">{funding.title}</h3>
            <p class="text-earth-700 leading-relaxed mb-6" set:html={funding.text} />
            <div class="grid grid-cols-2 gap-4">
              <div class="bg-cranberry-50 rounded-xl p-4 text-center">
                <div class="text-2xl font-bold text-cranberry-800 font-heading">{funding.assessmentRate}</div>
                <div class="text-earth-600 text-xs mt-1">{funding.assessmentLabel}</div>
              </div>
              <div class="bg-cranberry-50 rounded-xl p-4 text-center">
                <div class="text-2xl font-bold text-cranberry-800 font-heading">{funding.annualFunding}</div>
                <div class="text-earth-600 text-xs mt-1">{funding.annualFundingLabel}</div>
              </div>
            </div>
            <p class="text-earth-600 text-sm mt-4 leading-relaxed">
              {funding.note}
            </p>
          </div>

          <!-- History Highlights -->
          <div class="bg-cranberry-900 rounded-2xl p-8 text-white">
            <h3 class="text-2xl font-bold font-heading mb-4">{history.title}</h3>
            <dl class="space-y-4 text-sm">
              {history.entries.map((entry) => (
                <div class="flex items-start gap-3">
                  <dt class="text-cranberry-300 font-bold font-heading text-lg min-w-[4rem]">{entry.year}</dt>
                  <dd class="text-cranberry-100">{entry.description}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Board Members -->
  <section class="py-20 lg:py-28 bg-white border-t border-warm-200" aria-labelledby="board-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="text-cranberry-700 text-sm font-semibold uppercase tracking-widest mb-3">{boardSection.badge}</p>
        <h2 id="board-heading" class="text-3xl sm:text-4xl font-bold text-cranberry-950 font-heading mb-4">{boardSection.title}</h2>
        <p class="text-earth-600 max-w-2xl mx-auto">
          {boardSection.description}
        </p>
      </div>

      <div class="flex flex-wrap justify-center gap-6">
        {boardMembers.map((member) => (
          <div class="w-full sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] xl:w-[calc(25%-18px)]">
            <BoardMemberCard {...member} />
          </div>
        ))}
      </div>

      <p class="text-center text-earth-600 text-sm mt-10">
        {boardSection.electionNote.includes('(608)') ? (
          <Fragment set:html={boardSection.electionNote.replace('(608) 224-5046', '<a href="tel:6082245046" class="text-cranberry-700 hover:text-cranberry-800 underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cranberry-700 rounded-sm">(608) 224-5046</a>')} />
        ) : (
          boardSection.electionNote
        )}
      </p>
    </div>
  </section>

  <!-- Staff Section -->
  <section class="py-20 lg:py-28 bg-warm-50 border-t border-warm-200" aria-labelledby="staff-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-cranberry-700 text-sm font-semibold uppercase tracking-widest mb-3">{staff.badge}</p>
        <h2 id="staff-heading" class="text-3xl font-bold text-cranberry-950 font-heading mb-4">{staff.title}</h2>
        <p class="text-earth-600 mb-12">
          {staff.description}
        </p>

        <article class="bg-white rounded-2xl p-8 shadow-sm border border-warm-200 max-w-md mx-auto">
          <img
            src={staff.headshot}
            alt={`Portrait of ${staff.name}, ${staff.role}`}
            class="w-24 h-24 rounded-full object-cover mx-auto mb-4 ring-3 ring-cranberry-100"
            loading="lazy"
            decoding="async"
          />
          <h3 class="text-xl font-bold text-cranberry-900 font-heading">{staff.name}</h3>
          <p class="text-cranberry-600 font-medium">{staff.role}</p>
          <p class="text-earth-600 text-sm mt-4 leading-relaxed">
            {staff.bio}
          </p>
        </article>
      </div>
    </div>
  </section>

</Layout>
