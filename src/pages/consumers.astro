---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<Layout title="Consumers" description="Discover Wisconsin cranberries — the state's #1 fruit. Learn about cranberry nutrition, health benefits, and where to find consumer resources.">
  
  <Hero
    title="Wisconsin's State Fruit"
    subtitle="Experience Wisconsin Cranberries"
    description="From bog to table — discover why Wisconsin cranberries are loved around the world for their taste, nutrition, and heritage."
    image="/images/stock/cranberry-closeup-3.jpg"
    imageAlt="Close-up of ripe Wisconsin cranberries ready for harvest"
  />

  <Breadcrumb items={[{ label: 'Consumers' }]} />

  <!-- Cranberry Fun Facts -->
  <section class="py-20 lg:py-28 bg-warm-50" aria-labelledby="facts-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 id="facts-heading" class="text-3xl font-bold text-cranberry-950 font-heading mb-6">Did You Know?</h2>
          <div class="space-y-5">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-cranberry-100 rounded-full flex items-center justify-center flex-shrink-0" aria-hidden="true">
                <span class="text-cranberry-700 font-bold text-lg">🍒</span>
              </div>
              <div>
                <h3 class="font-bold text-cranberry-900">Native to Wisconsin</h3>
                <p class="text-earth-600 text-sm">Cranberries are native to Wisconsin's marshlands and have been harvested by Native Americans for centuries for food, medicine, and fabric dye.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-cranberry-100 rounded-full flex items-center justify-center flex-shrink-0" aria-hidden="true">
                <span class="text-cranberry-700 font-bold text-lg">🏆</span>
              </div>
              <div>
                <h3 class="font-bold text-cranberry-900">#1 in America</h3>
                <p class="text-earth-600 text-sm">Wisconsin has been the nation's leading cranberry producer for over 31 consecutive years, producing about 60% of the U.S. crop.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-cranberry-100 rounded-full flex items-center justify-center flex-shrink-0" aria-hidden="true">
                <span class="text-cranberry-700 font-bold text-lg">🥤</span>
              </div>
              <div>
                <h3 class="font-bold text-cranberry-900">Rich in Vitamin C</h3>
                <p class="text-earth-600 text-sm">One cup of raw cranberries provides 25% of your daily requirement of vitamin C. Sailors once ate cranberries to prevent scurvy at sea.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-cranberry-100 rounded-full flex items-center justify-center flex-shrink-0" aria-hidden="true">
                <span class="text-cranberry-700 font-bold text-lg">🌿</span>
              </div>
              <div>
                <h3 class="font-bold text-cranberry-900">Antioxidant Powerhouse</h3>
                <p class="text-earth-600 text-sm">Cranberries are well known for being rich in antioxidants and other beneficial compounds that support health and wellness.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-cranberry-100 rounded-full flex items-center justify-center flex-shrink-0" aria-hidden="true">
                <span class="text-cranberry-700 font-bold text-lg">🏡</span>
              </div>
              <div>
                <h3 class="font-bold text-cranberry-900">Family-Farmed</h3>
                <p class="text-earth-600 text-sm">Wisconsin's 250+ cranberry operations are primarily family farms, some of which have been in operation for over 100 years.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-cranberry-100 rounded-full flex items-center justify-center flex-shrink-0" aria-hidden="true">
                <span class="text-cranberry-700 font-bold text-lg">🐦</span>
              </div>
              <div>
                <h3 class="font-bold text-cranberry-900">"Crane Berry"</h3>
                <p class="text-earth-600 text-sm">European settlers named the fruit "crane berry" because the plant's stem and blossom resembled a sandhill crane.</p>
              </div>
            </div>
          </div>
        </div>

        <div>
          <img 
            src="/images/stock/cranberry-closeup-4.jpg"
            alt="Close-up view of fresh ripe Wisconsin cranberries during harvest season"
            class="rounded-2xl shadow-2xl w-full object-cover aspect-[4/3]"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- WSCGA Redirect -->
  <section class="py-20 lg:py-28 bg-cranberry-800" aria-labelledby="consumer-cta-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="w-20 h-20 bg-white/10 rounded-2xl flex items-center justify-center mx-auto mb-6" aria-hidden="true">
        <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"></path></svg>
      </div>
      <h2 id="consumer-cta-heading" class="text-3xl sm:text-4xl font-bold text-white font-heading mb-4">Looking for Consumer Resources?</h2>
      <p class="text-cranberry-200 text-lg leading-relaxed mb-8 max-w-2xl mx-auto">
        For recipes, festival information, cranberry products, and more consumer-focused content, visit the Wisconsin State Cranberry Growers Association at <strong>wiscran.org</strong>.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://www.wiscran.org" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-8 py-4 bg-white text-cranberry-900 rounded-lg font-semibold hover:bg-cranberry-50 transition-colors shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
          Visit wiscran.org
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          <span class="sr-only"> (opens in new tab)</span>
        </a>
        <a href="https://www.wiscran.org/Festivals" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white/30 text-white rounded-lg font-semibold hover:bg-white/10 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
          Find Cranberry Festivals
          <span class="sr-only"> (opens in new tab)</span>
        </a>
      </div>
    </div>
  </section>

</Layout>
