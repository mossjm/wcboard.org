---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import data from '../data/consumers.json';

const { hero, funFacts, consumerCta } = data;

// Lucide-style SVG icon paths for fun facts (24x24 viewBox, stroke-based)
const factIcons: Record<string, string[]> = {
  'map-pin': [
    'M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0Z',
    'M12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z',
  ],
  'trophy': [
    'M6 9H4.5a2.5 2.5 0 0 1 0-5H6',
    'M18 9h1.5a2.5 2.5 0 0 0 0-5H18',
    'M4 22h16',
    'M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22',
    'M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22',
    'M18 2H6v7a6 6 0 0 0 12 0V2Z',
  ],
  'heart': [
    'M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z',
  ],
  'shield': [
    'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z',
  ],
  'home': [
    'M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8',
    'M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z',
  ],
  'bird': [
    'M16 7h.01',
    'M3.4 18H12a8 8 0 0 0 8-8V7a4 4 0 0 0-7.28-2.3L2 20',
    'M20 7l2 3-2 1',
  ],
};
---

<Layout title="Consumers" description="Discover Wisconsin cranberries — the state's #1 fruit. Learn about cranberry nutrition, health benefits, and where to find consumer resources.">

  <Hero
    title={hero.title}
    subtitle={hero.subtitle}
    description={hero.description}
    image={hero.image}
    imageAlt={hero.imageAlt}
  />

  <Breadcrumb items={[{ label: 'Consumers' }]} />

  <!-- Cranberry Fun Facts -->
  <section class="py-20 lg:py-28 bg-warm-50" aria-labelledby="facts-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 id="facts-heading" class="text-3xl font-bold text-cranberry-950 font-heading mb-6">{funFacts.title}</h2>
          <div class="space-y-5">
            {funFacts.facts.map((fact) => (
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 bg-cranberry-100 rounded-full flex items-center justify-center flex-shrink-0" aria-hidden="true">
                  <svg class="w-5 h-5 text-cranberry-700" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    {(factIcons[fact.icon] || []).map((d) => <path d={d} />)}
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-cranberry-900">{fact.title}</h3>
                  <p class="text-earth-600 text-sm">{fact.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div>
          <img
            src={funFacts.image}
            alt={funFacts.imageAlt}
            class="rounded-2xl shadow-2xl w-full object-cover aspect-[4/3]"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- WSCGA Redirect -->
  <section class="py-20 lg:py-28 bg-cranberry-800" aria-labelledby="consumer-cta-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="w-20 h-20 bg-white/10 rounded-2xl flex items-center justify-center mx-auto mb-6" aria-hidden="true">
        <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"></path></svg>
      </div>
      <h2 id="consumer-cta-heading" class="text-3xl sm:text-4xl font-bold text-white font-heading mb-4">{consumerCta.title}</h2>
      <p class="text-cranberry-200 text-lg leading-relaxed mb-8 max-w-2xl mx-auto" set:html={consumerCta.description} />
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={consumerCta.primaryLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-8 py-4 bg-white text-cranberry-900 rounded-lg font-semibold hover:bg-cranberry-50 transition-colors shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
          {consumerCta.primaryLabel}
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          <span class="sr-only"> (opens in new tab)</span>
        </a>
        <a href={consumerCta.secondaryLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white/30 text-white rounded-lg font-semibold hover:bg-white/10 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
          {consumerCta.secondaryLabel}
          <span class="sr-only"> (opens in new tab)</span>
        </a>
      </div>
    </div>
  </section>

</Layout>
