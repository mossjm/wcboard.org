---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<Layout title="Contact" description="Get in touch with the Wisconsin Cranberry Board. Reach us by phone, mail, or through our contact form.">
  
  <Hero
    title="Contact Us"
    subtitle="Get in Touch"
    description="Have questions about the Wisconsin Cranberry Board, grower assessments, research programs, or board elections? We're here to help."
    image="/images/stock/cranberry-harvest-1.jpg"
    imageAlt="Panoramic view of a Wisconsin cranberry bog during harvest"
  />

  <Breadcrumb items={[{ label: 'Contact' }]} />

  <!-- Contact Content -->
  <section class="py-20 lg:py-28 bg-warm-50" aria-labelledby="contact-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-5 gap-16">
        
        <!-- Contact Form -->
        <div class="lg:col-span-3">
          <h2 id="contact-heading" class="text-3xl font-bold text-cranberry-950 font-heading mb-6">Send Us a Message</h2>
          <p class="text-earth-600 mb-8">
            Fill out the form below and we'll get back to you as soon as possible. For urgent inquiries, please call us directly.
          </p>

          <form class="space-y-6" action="#" method="POST" novalidate>
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label for="first-name" class="block text-sm font-medium text-earth-700 mb-2">
                  First Name <span class="text-cranberry-600" aria-hidden="true">*</span>
                  <span class="sr-only">(required)</span>
                </label>
                <input 
                  type="text" 
                  id="first-name" 
                  name="first-name" 
                  required 
                  autocomplete="given-name"
                  class="w-full px-4 py-3 rounded-xl border border-warm-300 bg-white text-earth-900 focus:ring-2 focus:ring-cranberry-500 focus:border-cranberry-500 transition-colors" 
                  aria-required="true"
                />
              </div>
              <div>
                <label for="last-name" class="block text-sm font-medium text-earth-700 mb-2">
                  Last Name <span class="text-cranberry-600" aria-hidden="true">*</span>
                  <span class="sr-only">(required)</span>
                </label>
                <input 
                  type="text" 
                  id="last-name" 
                  name="last-name" 
                  required
                  autocomplete="family-name"
                  class="w-full px-4 py-3 rounded-xl border border-warm-300 bg-white text-earth-900 focus:ring-2 focus:ring-cranberry-500 focus:border-cranberry-500 transition-colors" 
                  aria-required="true"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-earth-700 mb-2">
                Email Address <span class="text-cranberry-600" aria-hidden="true">*</span>
                <span class="sr-only">(required)</span>
              </label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required
                autocomplete="email"
                class="w-full px-4 py-3 rounded-xl border border-warm-300 bg-white text-earth-900 focus:ring-2 focus:ring-cranberry-500 focus:border-cranberry-500 transition-colors" 
                aria-required="true"
              />
            </div>

            <div>
              <label for="phone" class="block text-sm font-medium text-earth-700 mb-2">Phone Number</label>
              <input 
                type="tel" 
                id="phone" 
                name="phone"
                autocomplete="tel"
                class="w-full px-4 py-3 rounded-xl border border-warm-300 bg-white text-earth-900 focus:ring-2 focus:ring-cranberry-500 focus:border-cranberry-500 transition-colors" 
              />
            </div>

            <div>
              <label for="subject" class="block text-sm font-medium text-earth-700 mb-2">
                Subject <span class="text-cranberry-600" aria-hidden="true">*</span>
                <span class="sr-only">(required)</span>
              </label>
              <select 
                id="subject" 
                name="subject" 
                required
                class="w-full px-4 py-3 rounded-xl border border-warm-300 bg-white text-earth-900 focus:ring-2 focus:ring-cranberry-500 focus:border-cranberry-500 transition-colors" 
                aria-required="true"
              >
                <option value="">Select a topic...</option>
                <option value="general">General Inquiry</option>
                <option value="assessment">Grower Assessment</option>
                <option value="research">Research & Programs</option>
                <option value="elections">Board Elections</option>
                <option value="media">Media Inquiry</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-earth-700 mb-2">
                Message <span class="text-cranberry-600" aria-hidden="true">*</span>
                <span class="sr-only">(required)</span>
              </label>
              <textarea 
                id="message" 
                name="message" 
                rows="5" 
                required
                class="w-full px-4 py-3 rounded-xl border border-warm-300 bg-white text-earth-900 focus:ring-2 focus:ring-cranberry-500 focus:border-cranberry-500 transition-colors resize-y"
                aria-required="true"
              ></textarea>
            </div>

            <!-- [PLACEHOLDER: Contact form needs a backend service (e.g., Formspree, Cloudflare Workers, or custom API) for form submissions] -->
            <button type="submit" class="px-8 py-4 bg-cranberry-700 text-white rounded-xl font-semibold hover:bg-cranberry-800 transition-colors shadow-sm w-full sm:w-auto focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cranberry-900">
              Send Message
            </button>
          </form>
        </div>

        <!-- Contact Info Sidebar -->
        <aside class="lg:col-span-2" aria-label="Contact information">
          <div class="space-y-8">
            <!-- Board Office -->
            <div class="bg-white rounded-2xl p-8 border border-warm-200 shadow-sm">
              <h3 class="text-xl font-bold text-cranberry-900 font-heading mb-6">Board Office</h3>
              
              <address class="not-italic space-y-5">
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 bg-cranberry-100 rounded-lg flex items-center justify-center flex-shrink-0" aria-hidden="true">
                    <svg class="w-5 h-5 text-cranberry-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                  </div>
                  <div>
                    <h4 class="font-semibold text-cranberry-900 text-sm">Mailing Address</h4>
                    <p class="text-earth-600 text-sm mt-1">
                      Wisconsin Cranberry Board<br />
                      P.O. Box 1351<br />
                      Wisconsin Rapids, WI 54494
                    </p>
                  </div>
                </div>

                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 bg-cranberry-100 rounded-lg flex items-center justify-center flex-shrink-0" aria-hidden="true">
                    <svg class="w-5 h-5 text-cranberry-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                  </div>
                  <div>
                    <h4 class="font-semibold text-cranberry-900 text-sm">Phone</h4>
                    <a href="tel:7154232070" class="text-cranberry-700 hover:text-cranberry-800 transition-colors text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cranberry-700 rounded-sm">(715) 423-2070</a>
                  </div>
                </div>
              </address>
            </div>

            <!-- DATCP Contact -->
            <div class="bg-cranberry-50 rounded-2xl p-8 border border-cranberry-100">
              <h3 class="text-xl font-bold text-cranberry-900 font-heading mb-4">Election Questions?</h3>
              <p class="text-earth-600 text-sm leading-relaxed mb-4">
                For questions about Board elections, nominations, and voting, contact the DATCP Market Orders Program.
              </p>
              <div class="flex items-center gap-3">
                <svg class="w-5 h-5 text-cranberry-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                <a href="tel:6082245046" class="text-cranberry-700 hover:text-cranberry-800 transition-colors text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cranberry-700 rounded-sm">(608) 224-5046</a>
              </div>
              <p class="text-earth-600 text-xs mt-3">
                DATCP Market Orders Program<br />
                Madison, Wisconsin
              </p>
            </div>

            <!-- Quick Links -->
            <div class="bg-white rounded-2xl p-8 border border-warm-200 shadow-sm">
              <h3 class="text-xl font-bold text-cranberry-900 font-heading mb-4">Quick Links</h3>
              <ul class="space-y-3" role="list">
                <li>
                  <a href="/about" class="text-cranberry-700 hover:text-cranberry-800 transition-colors text-sm font-medium inline-flex items-center gap-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cranberry-700 rounded-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    About the Board
                  </a>
                </li>
                <li>
                  <a href="/grower-resources" class="text-cranberry-700 hover:text-cranberry-800 transition-colors text-sm font-medium inline-flex items-center gap-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cranberry-700 rounded-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    Grower Resources
                  </a>
                </li>
                <li>
                  <a href="/programs-research" class="text-cranberry-700 hover:text-cranberry-800 transition-colors text-sm font-medium inline-flex items-center gap-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cranberry-700 rounded-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    Programs & Research
                  </a>
                </li>
                <li>
                  <a href="https://datcp.wi.gov/Pages/AgDevelopment/WisconsinCranberryBoard.aspx" target="_blank" rel="noopener noreferrer" class="text-cranberry-700 hover:text-cranberry-800 transition-colors text-sm font-medium inline-flex items-center gap-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cranberry-700 rounded-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                    DATCP Board Page
                    <span class="sr-only"> (opens in new tab)</span>
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

</Layout>
