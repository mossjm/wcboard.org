---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="Get in touch with the Wisconsin Cranberry Board. Reach us by phone, mail, or through our contact form.">
  
  <!-- Page Hero -->
  <section class="relative bg-cranberry-950 overflow-hidden">
    <div class="absolute inset-0">
      <img 
        src="/images/stock/cranberry-harvest-1.jpg"
        alt="Wisconsin cranberry bog"
        class="w-full h-full object-cover opacity-25"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-cranberry-950/90 to-cranberry-950/60"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
      <p class="text-cranberry-300 text-sm font-semibold uppercase tracking-widest mb-4">Get in Touch</p>
      <h1 class="text-4xl sm:text-5xl font-bold text-white font-heading mb-6 max-w-3xl leading-tight">
        Contact Us
      </h1>
      <p class="text-cranberry-100 text-lg max-w-2xl leading-relaxed">
        Have questions about the Wisconsin Cranberry Board, grower assessments, research programs, or board elections? We're here to help.
      </p>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav class="bg-warm-100 border-b border-warm-200" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <ol class="flex items-center gap-2 text-sm text-earth-500">
        <li><a href="/" class="hover:text-cranberry-700 transition-colors">Home</a></li>
        <li><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"></path></svg></li>
        <li class="text-cranberry-800 font-medium">Contact</li>
      </ol>
    </div>
  </nav>

  <!-- Contact Content -->
  <section class="py-20 lg:py-28 bg-warm-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-5 gap-16">
        
        <!-- Contact Form -->
        <div class="lg:col-span-3">
          <h2 class="text-3xl font-bold text-cranberry-950 font-heading mb-6">Send Us a Message</h2>
          <p class="text-earth-600 mb-8">
            Fill out the form below and we'll get back to you as soon as possible. For urgent inquiries, please call us directly.
          </p>

          <!-- [PLACEHOLDER: Contact form will need a backend service (e.g., Formspree, Netlify Forms, or custom API) for form submissions] -->
          <form class="space-y-6" action="#" method="POST">
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label for="first-name" class="block text-sm font-medium text-earth-700 mb-2">First Name <span class="text-cranberry-600">*</span></label>
                <input type="text" id="first-name" name="first-name" required class="w-full px-4 py-3 rounded-xl border border-warm-300 bg-white text-earth-900 focus:ring-2 focus:ring-cranberry-500 focus:border-cranberry-500 transition-colors" />
              </div>
              <div>
                <label for="last-name" class="block text-sm font-medium text-earth-700 mb-2">Last Name <span class="text-cranberry-600">*</span></label>
                <input type="text" id="last-name" name="last-name" required class="w-full px-4 py-3 rounded-xl border border-warm-300 bg-white text-earth-900 focus:ring-2 focus:ring-cranberry-500 focus:border-cranberry-500 transition-colors" />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-earth-700 mb-2">Email Address <span class="text-cranberry-600">*</span></label>
              <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-xl border border-warm-300 bg-white text-earth-900 focus:ring-2 focus:ring-cranberry-500 focus:border-cranberry-500 transition-colors" />
            </div>

            <div>
              <label for="phone" class="block text-sm font-medium text-earth-700 mb-2">Phone Number</label>
              <input type="tel" id="phone" name="phone" class="w-full px-4 py-3 rounded-xl border border-warm-300 bg-white text-earth-900 focus:ring-2 focus:ring-cranberry-500 focus:border-cranberry-500 transition-colors" />
            </div>

            <div>
              <label for="subject" class="block text-sm font-medium text-earth-700 mb-2">Subject <span class="text-cranberry-600">*</span></label>
              <select id="subject" name="subject" required class="w-full px-4 py-3 rounded-xl border border-warm-300 bg-white text-earth-900 focus:ring-2 focus:ring-cranberry-500 focus:border-cranberry-500 transition-colors">
                <option value="">Select a topic...</option>
                <option value="general">General Inquiry</option>
                <option value="assessment">Grower Assessment</option>
                <option value="research">Research & Programs</option>
                <option value="elections">Board Elections</option>
                <option value="media">Media Inquiry</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-earth-700 mb-2">Message <span class="text-cranberry-600">*</span></label>
              <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 rounded-xl border border-warm-300 bg-white text-earth-900 focus:ring-2 focus:ring-cranberry-500 focus:border-cranberry-500 transition-colors resize-y"></textarea>
            </div>

            <button type="submit" class="px-8 py-4 bg-cranberry-700 text-white rounded-xl font-semibold hover:bg-cranberry-800 transition-colors shadow-sm w-full sm:w-auto">
              Send Message
            </button>
          </form>
        </div>

        <!-- Contact Info Sidebar -->
        <div class="lg:col-span-2">
          <div class="space-y-8">
            <!-- Board Office -->
            <div class="bg-white rounded-2xl p-8 border border-warm-200 shadow-sm">
              <h3 class="text-xl font-bold text-cranberry-900 font-heading mb-6">Board Office</h3>
              
              <div class="space-y-5">
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 bg-cranberry-100 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-cranberry-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                  </div>
                  <div>
                    <h4 class="font-semibold text-cranberry-900 text-sm">Mailing Address</h4>
                    <p class="text-earth-600 text-sm mt-1">
                      Wisconsin Cranberry Board<br />
                      P.O. Box 1351<br />
                      Wisconsin Rapids, WI 54494
                    </p>
                  </div>
                </div>

                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 bg-cranberry-100 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-cranberry-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                  </div>
                  <div>
                    <h4 class="font-semibold text-cranberry-900 text-sm">Phone</h4>
                    <a href="tel:7154232070" class="text-cranberry-700 hover:text-cranberry-800 transition-colors text-sm font-medium">(715) 423-2070</a>
                  </div>
                </div>
              </div>
            </div>

            <!-- DATCP Contact -->
            <div class="bg-cranberry-50 rounded-2xl p-8 border border-cranberry-100">
              <h3 class="text-xl font-bold text-cranberry-900 font-heading mb-4">Election Questions?</h3>
              <p class="text-earth-600 text-sm leading-relaxed mb-4">
                For questions about Board elections, nominations, and voting, contact the DATCP Market Orders Program.
              </p>
              <div class="flex items-center gap-3">
                <svg class="w-5 h-5 text-cranberry-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                <a href="tel:6082245046" class="text-cranberry-700 hover:text-cranberry-800 transition-colors text-sm font-medium">(608) 224-5046</a>
              </div>
              <p class="text-earth-500 text-xs mt-3">
                DATCP Market Orders Program<br />
                Madison, Wisconsin
              </p>
            </div>

            <!-- Quick Links -->
            <div class="bg-white rounded-2xl p-8 border border-warm-200 shadow-sm">
              <h3 class="text-xl font-bold text-cranberry-900 font-heading mb-4">Quick Links</h3>
              <ul class="space-y-3">
                <li>
                  <a href="/about" class="text-cranberry-700 hover:text-cranberry-800 transition-colors text-sm font-medium inline-flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    About the Board
                  </a>
                </li>
                <li>
                  <a href="/grower-resources" class="text-cranberry-700 hover:text-cranberry-800 transition-colors text-sm font-medium inline-flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    Grower Resources
                  </a>
                </li>
                <li>
                  <a href="/programs-research" class="text-cranberry-700 hover:text-cranberry-800 transition-colors text-sm font-medium inline-flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    Programs & Research
                  </a>
                </li>
                <li>
                  <a href="https://datcp.wi.gov/Pages/AgDevelopment/WisconsinCranberryBoard.aspx" target="_blank" rel="noopener" class="text-cranberry-700 hover:text-cranberry-800 transition-colors text-sm font-medium inline-flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                    DATCP Board Page
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
