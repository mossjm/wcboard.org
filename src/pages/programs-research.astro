---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import data from '../data/programs-research.json';

const { hero, funding, researchAreas, partnerships, education, cta } = data;

// SVG icon paths for research areas (not CMS-editable, design concern)
const areaIcons = [
  { bg: 'bg-forest-100', color: 'text-forest-700', path: 'M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z' },
  { bg: 'bg-cranberry-100', color: 'text-cranberry-700', path: 'M12 12.75c1.148 0 2.278.08 3.383.237 1.037.146 1.866.966 1.866 2.013 0 3.728-2.35 6.75-5.25 6.75S6.75 18.728 6.75 15c0-1.046.83-1.867 1.866-2.013A24.204 24.204 0 0112 12.75zm0 0c2.883 0 5.647.508 8.207 1.44a23.91 23.91 0 01-1.152 6.06M12 12.75c-2.883 0-5.647.508-8.208 1.44.125 2.104.52 4.136 1.153 6.06M12 12.75a2.25 2.25 0 002.248-2.354M12 12.75a2.25 2.25 0 01-2.248-2.354M12 8.25c.995 0 1.971-.08 2.922-.236.403-.066.74-.358.795-.762a3.778 3.778 0 00-.399-2.25M12 8.25c-.995 0-1.97-.08-2.922-.236-.402-.066-.74-.358-.795-.762a3.734 3.734 0 01.4-2.253M12 8.25a2.25 2.25 0 00-2.248 2.146M12 8.25a2.25 2.25 0 012.248 2.146M8.683 5a6.032 6.032 0 01-1.155-1.002c.07-.63.27-1.222.574-1.747m.581 2.749A3.75 3.75 0 0115.318 5m0 0c.427-.283.815-.62 1.155-.999a4.471 4.471 0 00-.575-1.752M4.921 6a24.048 24.048 0 00-.392 3.314c1.668.546 3.416.914 5.223 1.082M19.08 6c.205 1.08.337 2.187.392 3.314a23.882 23.882 0 01-5.223 1.082' },
  { bg: 'bg-earth-100', color: 'text-earth-700', path: 'M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6' },
  { bg: 'bg-forest-100', color: 'text-forest-700', path: 'M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z' },
  { bg: 'bg-cranberry-100', color: 'text-cranberry-700', path: 'M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z' },
  { bg: 'bg-earth-100', color: 'text-earth-700', path: 'M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082' },
];
---

<Layout title="Programs & Research" description="Explore the research projects and educational programs funded by the Wisconsin Cranberry Board to advance Wisconsin's cranberry industry.">

  <Hero
    title={hero.title}
    subtitle={hero.subtitle}
    description={hero.description}
    image={hero.image}
    imageAlt={hero.imageAlt}
  />

  <Breadcrumb items={[{ label: 'Programs & Research' }]} />

  <!-- 2025 Funding Overview -->
  <section class="py-20 lg:py-28 bg-warm-50" aria-labelledby="funding-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="text-cranberry-700 text-sm font-semibold uppercase tracking-widest mb-3">{funding.badge}</p>
        <h2 id="funding-heading" class="text-3xl sm:text-4xl font-bold text-cranberry-950 font-heading mb-4">{funding.title}</h2>
        <p class="text-earth-600 max-w-3xl mx-auto text-lg">
          {funding.description}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <article class="bg-white rounded-2xl p-8 border border-warm-200 shadow-sm text-center">
          <div class="w-16 h-16 bg-cranberry-100 rounded-2xl flex items-center justify-center mx-auto mb-4" aria-hidden="true">
            <svg class="w-8 h-8 text-cranberry-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.662 48.662 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5"></path>
            </svg>
          </div>
          <div class="text-3xl font-bold text-cranberry-800 font-heading mb-1">{funding.researchCount}</div>
          <div class="text-earth-700 font-medium mb-2">{funding.researchLabel}</div>
          <div class="text-earth-600 text-sm">{funding.researchDetail}</div>
        </article>

        <article class="bg-white rounded-2xl p-8 border border-warm-200 shadow-sm text-center">
          <div class="w-16 h-16 bg-forest-100 rounded-2xl flex items-center justify-center mx-auto mb-4" aria-hidden="true">
            <svg class="w-8 h-8 text-forest-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342"></path>
            </svg>
          </div>
          <div class="text-3xl font-bold text-forest-700 font-heading mb-1">{funding.educationCount}</div>
          <div class="text-earth-700 font-medium mb-2">{funding.educationLabel}</div>
          <div class="text-earth-600 text-sm">{funding.educationDetail}</div>
        </article>
      </div>
    </div>
  </section>

  <!-- Research Focus Areas -->
  <section class="py-20 lg:py-28 bg-white border-t border-warm-200" aria-labelledby="research-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="text-cranberry-700 text-sm font-semibold uppercase tracking-widest mb-3">{researchAreas.badge}</p>
        <h2 id="research-heading" class="text-3xl sm:text-4xl font-bold text-cranberry-950 font-heading mb-4">{researchAreas.title}</h2>
        <p class="text-earth-600 max-w-2xl mx-auto">
          {researchAreas.description}
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {researchAreas.areas.map((area, i) => {
          const icon = areaIcons[i] || areaIcons[0];
          return (
            <article class="bg-warm-50 rounded-2xl p-8 border border-warm-200">
              <div class={`w-12 h-12 ${icon.bg} rounded-xl flex items-center justify-center mb-5`} aria-hidden="true">
                <svg class={`w-6 h-6 ${icon.color}`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={icon.path}></path></svg>
              </div>
              <h3 class="text-xl font-bold text-cranberry-900 font-heading mb-3">{area.title}</h3>
              <p class="text-earth-600 text-sm leading-relaxed">
                {area.description}
              </p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Research Partnerships -->
  <section class="py-20 lg:py-28 bg-cranberry-900" aria-labelledby="partnerships-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="text-cranberry-300 text-sm font-semibold uppercase tracking-widest mb-3">{partnerships.badge}</p>
        <h2 id="partnerships-heading" class="text-3xl sm:text-4xl font-bold text-white font-heading mb-4">{partnerships.title}</h2>
        <p class="text-cranberry-200 max-w-2xl mx-auto">
          {partnerships.description}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {partnerships.partners.map((partner) => (
          <article class="bg-white/10 backdrop-blur-sm rounded-2xl p-8 border border-white/10">
            <h3 class="text-xl font-bold text-white font-heading mb-3">{partner.name}</h3>
            <p class="text-cranberry-200 text-sm leading-relaxed mb-4">
              {partner.description}
            </p>
            <a href={partner.linkUrl} target="_blank" rel="noopener noreferrer" class="text-cranberry-300 text-sm font-medium hover:text-white transition-colors inline-flex items-center gap-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm">
              {partner.linkText}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
              <span class="sr-only"> (opens in new tab)</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Education & Promotion -->
  <section class="py-20 lg:py-28 bg-warm-50 border-t border-warm-200" aria-labelledby="education-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-cranberry-700 text-sm font-semibold uppercase tracking-widest mb-3">{education.badge}</p>
          <h2 id="education-heading" class="text-3xl sm:text-4xl font-bold text-cranberry-950 font-heading mb-6 leading-tight">{education.title}</h2>
          <p class="text-earth-700 text-lg leading-relaxed mb-6">
            {education.description}
          </p>
          <ul class="space-y-4" role="list">
            {education.items.map((item) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-cranberry-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                <span class="text-earth-700"><strong>{item.label}</strong> — {item.detail}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <img
            src={education.image}
            alt={education.imageAlt}
            class="rounded-2xl shadow-2xl w-full object-cover aspect-[4/3]"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Call for Proposals CTA -->
  <section class="py-16 bg-cranberry-800" aria-labelledby="cta-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 id="cta-heading" class="text-2xl sm:text-3xl font-bold text-white font-heading mb-4">{cta.title}</h2>
      <p class="text-cranberry-200 max-w-2xl mx-auto mb-8" set:html={cta.description} />
      <a href={cta.linkUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-8 py-4 bg-white text-cranberry-900 rounded-lg font-semibold hover:bg-cranberry-50 transition-colors shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
        {cta.linkText}
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        <span class="sr-only"> (opens in new tab)</span>
      </a>
    </div>
  </section>

</Layout>
