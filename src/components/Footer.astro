---
const currentYear = new Date().getFullYear();
---

<footer class="bg-cranberry-950 text-white" role="contentinfo">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- About Column -->
      <div class="lg:col-span-1">
        <div class="mb-4">
          <img 
            src="/images/wcb-logo-white.png" 
            alt="Wisconsin Cranberry Board"
            class="h-16 w-auto object-contain"
          />
        </div>
        <p class="text-cranberry-200 text-sm leading-relaxed">
          Supporting and advancing Wisconsin's cranberry industry through strategic investments in research, promotion, and education.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-cranberry-300 mb-4">Quick Links</h2>
        <ul class="space-y-3" role="list">
          <li><a href="/about" class="text-cranberry-100 hover:text-white transition-colors text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm">About the Board</a></li>
          <li><a href="/meetings" class="text-cranberry-100 hover:text-white transition-colors text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm">Meetings & Events</a></li>
          <li><a href="/grower-resources" class="text-cranberry-100 hover:text-white transition-colors text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm">Grower Resources</a></li>
          <li><a href="/programs-research" class="text-cranberry-100 hover:text-white transition-colors text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm">Programs & Research</a></li>
          <li><a href="/consumers" class="text-cranberry-100 hover:text-white transition-colors text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm">Consumers</a></li>
          <li><a href="/contact" class="text-cranberry-100 hover:text-white transition-colors text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm">Contact</a></li>
        </ul>
      </div>

      <!-- Related Organizations -->
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-cranberry-300 mb-4">Related Organizations</h2>
        <ul class="space-y-3" role="list">
          <li><a href="https://www.wiscran.org" target="_blank" rel="noopener noreferrer" class="text-cranberry-100 hover:text-white transition-colors text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm">WI Cranberry Growers Assoc.<span class="sr-only"> (opens in new tab)</span></a></li>
          <li><a href="https://www.wisconsincranberryresearchstation.org" target="_blank" rel="noopener noreferrer" class="text-cranberry-100 hover:text-white transition-colors text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm">WI Cranberry Research Station<span class="sr-only"> (opens in new tab)</span></a></li>
          <li><a href="https://fruit.wisc.edu/cranberries/" target="_blank" rel="noopener noreferrer" class="text-cranberry-100 hover:text-white transition-colors text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm">UW-Madison Cranberry Research<span class="sr-only"> (opens in new tab)</span></a></li>
          <li><a href="https://datcp.wi.gov" target="_blank" rel="noopener noreferrer" class="text-cranberry-100 hover:text-white transition-colors text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm">WI Dept. of Agriculture (DATCP)<span class="sr-only"> (opens in new tab)</span></a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-cranberry-300 mb-4">Contact Us</h2>
        <address class="not-italic">
          <ul class="space-y-3 text-sm text-cranberry-100" role="list">
            <li class="flex items-start gap-2">
              <svg class="w-4 h-4 mt-0.5 text-cranberry-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
              <span>P.O. Box 1351<br />Wisconsin Rapids, WI 54494</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-cranberry-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              <a href="tel:7154232070" class="hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm">(715) 423-2070</a>
            </li>
          </ul>
        </address>
      </div>
    </div>

    <div class="border-t border-cranberry-800 mt-12 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-cranberry-300 text-xs">
        &copy; {currentYear} Wisconsin Cranberry Board. All rights reserved.
      </p>
      <p class="text-cranberry-400 text-xs">
        Administered under <a href="https://datcp.wi.gov" class="underline hover:text-cranberry-200 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white rounded-sm">DATCP<span class="sr-only"> (opens in new tab)</span></a> Market Orders Program
      </p>
    </div>
  </div>
</footer>
