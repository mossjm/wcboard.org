---
interface Props {
  name: string;
  position: string;
  location: string;
  term: string;
  headshot?: string;
  bio?: string;
}

const { name, position, location, term, headshot, bio } = Astro.props;

// Generate initials for placeholder
const initials = name.split(' ').map(n => n[0]).join('');
---

<article class="bg-warm-50 rounded-2xl p-6 border border-warm-200 hover:border-cranberry-300 hover:shadow-md transition-all duration-300">
  <div class="flex flex-col items-center text-center">
    <!-- Headshot or Placeholder -->
    {headshot ? (
      <img 
        src={headshot} 
        alt={`Portrait of ${name}, ${position}`}
        class="w-24 h-24 rounded-full object-cover mb-4 ring-3 ring-cranberry-100"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div 
        class="w-24 h-24 bg-gradient-to-br from-cranberry-600 to-cranberry-800 rounded-full flex items-center justify-center mb-4 ring-3 ring-cranberry-100" 
        role="img"
        aria-label={`Photo placeholder for ${name}`}
      >
        <span class="text-white text-xl font-bold font-heading" aria-hidden="true">{initials}</span>
      </div>
    )}
    
    <h3 class="text-lg font-bold text-cranberry-900 font-heading">{name}</h3>
    <p class="text-cranberry-600 font-medium text-sm mt-0.5">{position}</p>
    <div class="flex items-center gap-1.5 mt-2 text-earth-500 text-xs">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
      <span>{location}</span>
    </div>
    <p class="text-earth-400 text-xs mt-1">{term}</p>
    {bio && (
      <p class="text-earth-600 text-sm mt-3 leading-relaxed">{bio}</p>
    )}
  </div>
</article>
