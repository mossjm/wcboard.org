---
interface Props {
  title: string;
  subtitle?: string;
  description: string;
  image: string;
  imageAlt: string;
  badge?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  size?: 'default' | 'large';
}

const { 
  title, 
  subtitle, 
  description, 
  image, 
  imageAlt, 
  badge,
  primaryCta, 
  secondaryCta,
  size = 'default'
} = Astro.props;

const paddingClass = size === 'large' ? 'py-28 lg:py-40' : 'py-20 lg:py-28';
---

<section class="relative bg-cranberry-950 overflow-hidden" aria-labelledby="hero-title">
  <div class="absolute inset-0">
    <img 
      src={image}
      alt={imageAlt}
      class="w-full h-full object-cover opacity-30"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-cranberry-950/90 via-cranberry-950/70 to-cranberry-950/50"></div>
  </div>
  <div class={`relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 ${paddingClass}`}>
    <div class="max-w-3xl">
      {badge && (
        <p class="text-cranberry-300 text-sm font-semibold uppercase tracking-widest mb-4">{badge}</p>
      )}
      {subtitle && (
        <p class="text-cranberry-300 text-sm font-semibold uppercase tracking-widest mb-4">{subtitle}</p>
      )}
      <h1 id="hero-title" class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight font-heading mb-6">
        {title}
      </h1>
      <p class="text-lg sm:text-xl text-cranberry-100 leading-relaxed mb-10 max-w-2xl">
        {description}
      </p>
      {(primaryCta || secondaryCta) && (
        <div class="flex flex-col sm:flex-row gap-4">
          {primaryCta && (
            <a href={primaryCta.href} class="inline-flex items-center justify-center px-8 py-4 bg-white text-cranberry-900 rounded-lg font-semibold hover:bg-cranberry-50 transition-colors shadow-lg text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
              {primaryCta.label}
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </a>
          )}
          {secondaryCta && (
            <a href={secondaryCta.href} class="inline-flex items-center justify-center px-8 py-4 border-2 border-white/30 text-white rounded-lg font-semibold hover:bg-white/10 transition-colors text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
              {secondaryCta.label}
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</section>
