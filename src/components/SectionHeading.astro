---
interface Props {
  badge?: string;
  title: string;
  description?: string;
  align?: 'center' | 'left';
  light?: boolean;
}

const { badge, title, description, align = 'center', light = false } = Astro.props;

const alignClass = align === 'center' ? 'text-center mx-auto' : '';
const badgeColor = light ? 'text-cranberry-300' : 'text-cranberry-700';
const titleColor = light ? 'text-white' : 'text-cranberry-950';
const descColor = light ? 'text-cranberry-200' : 'text-earth-600';
---

<div class={`mb-16 ${alignClass}`}>
  {badge && (
    <p class={`${badgeColor} text-sm font-semibold uppercase tracking-widest mb-3`}>{badge}</p>
  )}
  <h2 class={`text-3xl sm:text-4xl font-bold ${titleColor} font-heading mb-4`}>{title}</h2>
  {description && (
    <p class={`${descColor} max-w-2xl ${align === 'center' ? 'mx-auto' : ''} text-lg`}>{description}</p>
  )}
</div>
